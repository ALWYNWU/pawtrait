# Copy this file to `.env.local` and fill in the values.
# See SETUP.md for step-by-step registration instructions (both services are free).
# NOTE: after changing .env.local you must restart `npm run dev`.
# On Vercel, add the same three variables under Project Settings → Environment Variables.

# From https://web3forms.com — the access key tied to pawtraitpet@gmail.com
VITE_WEB3FORMS_ACCESS_KEY=

# From https://cloudinary.com dashboard — your "Cloud name"
VITE_CLOUDINARY_CLOUD_NAME=

# The unsigned upload preset name you create in Cloudinary (e.g. pawtrait_orders)
VITE_CLOUDINARY_UPLOAD_PRESET=
